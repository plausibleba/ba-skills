# Supabase Configuration (D-108: Backend Architecture)
# Get these from your Supabase project: Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Anthropic API Key (existing — used by /api/claude edge proxy)
ANTHROPIC_API_KEY=your-anthropic-key-here

# Stripe (used by /api/checkout and /api/stripe-webhook edge functions)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# Supabase service role (used by webhook to update profiles server-side)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
