{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/value-cognition/schemas/FrictionHeatmap.schema.json",
  "title": "FrictionHeatmap",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "heatmapId",
    "scaffoldId",
    "valueStreamId",
    "createdAt",
    "observations",
    "bindingConstraint"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$"
    },
    "heatmapId": { "type": "string", "minLength": 1 },
    "scaffoldId": { "type": "string", "minLength": 1 },

    "scaffoldIntegrityHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 hash copied from the scaffold's modelIntegrityHash. Used to validate that the heatmap references an unchanged baseline scaffold. Must match scaffold.modelIntegrityHash on load."
    },

    "valueStreamId": {
      "type": "string",
      "minLength": 1,
      "description": "The ValueStream element ID this heatmap applies to."
    },

    "createdAt": { "type": "string", "format": "date-time" },
    "createdBy": { "type": "string" },

    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workshopName": { "type": "string" },
        "timebox": { "type": "string" },
        "notes": { "type": "string" }
      }
    },

    "observations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/FrictionObservation" }
    },

    "bindingConstraint": { "$ref": "#/$defs/BindingConstraintFinding" }
  },

  "$defs": {
    "Id": { "type": "string", "minLength": 1 },

    "AnchorRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchorType", "anchorId"],
      "properties": {
        "anchorType": {
          "type": "string",
          "enum": [
            "Goal", "Strategy", "Directive", "Objective", "Initiative", "Control",
            "Capability", "ValueStream", "Constraint",
            "Role", "Interaction", "DeonticLogic",
            "Outcome", "Activity", "FlowLogic",
            "Concept", "Property",
            "Metric", "Condition"
          ]
        },
        "anchorId": { "$ref": "#/$defs/Id" }
      }
    },

    "FrictionCategory": {
      "type": "string",
      "enum": [
        "ProcessHandoffFriction",
        "TechnologyIntegrationFriction",
        "DataSignalFriction",
        "DecisionAuthorityFriction",
        "GovernanceRiskFriction",
        "IncentiveCapacityFriction"
      ]
    },

    "Intensity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["scale", "score"],
          "properties": {
            "scale": { "const": "0-10" },
            "score": { "type": "number", "minimum": 0, "maximum": 10 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["scale", "severity"],
          "properties": {
            "scale": { "const": "ordinal" },
            "severity": {
              "type": "string",
              "enum": ["Low", "Medium", "High", "Critical"]
            }
          }
        }
      ]
    },

    "FrictionObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observationId", "category", "primaryAnchor", "intensity", "rationale"],
      "properties": {
        "observationId": { "$ref": "#/$defs/Id" },

        "category": { "$ref": "#/$defs/FrictionCategory" },

        "primaryAnchor": { "$ref": "#/$defs/AnchorRef" },

        "contributingAnchors": {
          "type": "array",
          "items": { "$ref": "#/$defs/AnchorRef" },
          "uniqueItems": true
        },

        "intensity": { "$ref": "#/$defs/Intensity" },

        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Confidence in this observation (0.0 = no confidence, 1.0 = absolute certainty)."
        },

        "rationale": { "type": "string", "minLength": 1 },

        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/EvidenceRef" },
          "uniqueItems": true
        },

        "observedAt": { "type": "string", "format": "date-time" }
      }
    },

    "EvidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceType", "ref"],
      "properties": {
        "evidenceType": {
          "type": "string",
          "enum": ["Note", "TranscriptQuote", "Ticket", "Dashboard", "Document", "Link"]
        },
        "ref": { 
          "type": "string", 
          "minLength": 1,
          "description": "Reference to evidence source (URI, ticket ID, document path, etc.)."
        },
        "snippet": { "type": "string" }
      }
    },

    "BindingConstraintFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "findingId",
        "bindingAnchor",
        "bindingAnchorObservationId",
        "justification"
      ],
      "properties": {
        "findingId": { "$ref": "#/$defs/Id" },

        "bindingAnchor": { 
          "$ref": "#/$defs/AnchorRef",
          "description": "VALIDATION NOTE: Implementations must verify this anchor appears in observations[*].primaryAnchor or observations[*].contributingAnchors[] (see Appendix E: Validation Rules)."
        },

        "bindingAnchorObservationId": {
          "$ref": "#/$defs/Id",
          "description": "Must reference an observationId whose primaryAnchor or contributingAnchors include bindingAnchor."
        },

        "justification": { "type": "string", "minLength": 1 },

        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Confidence in this binding constraint finding (0.0 = no confidence, 1.0 = absolute certainty)."
        },

        "observedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
